
@model MyLoginRegistration.Models.UserAccount
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Create";
}

<style>
    body {
        background: #f5f7fa;
    }
</style>

<h2>CreateEmployee</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div style="max-width: 500px; margin: 60px auto; padding: 25px; border: 1px solid #ddd; border-radius: 10px; background: #fff; box-shadow: 0px 4px 12px rgba(0,0,0,0.1);">
        <h4>UserAccount</h4>
        <hr />
        @Html.ValidationSummary(true, "Check The Errors Below", new { @class = "text-danger" })
        @if (ViewBag.Message != null)
        {
            <div class="form-group">
                <div style="margin-bottom: 15px; color: green; font-weight: 500;">@ViewBag.Message</div>
            </div>
        }
        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-2", id = "empName" })
            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { style = "width:100%; padding:8px;" } })
            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-2" })
            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { style = "width:100%; padding:8px;" } })
            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-md-2" })
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { style = "width:100%; padding:8px;" } })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.Username, htmlAttributes: new { @class = "control-label col-md-2" })
            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { style = "width:100%; padding:8px;" } })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-md-2" })
            @Html.PasswordFor(model => model.Password, new { style = "width:100%; padding:8px;" })
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.ConfirmPassword, htmlAttributes: new { @class = "control-label col-md-2" })
            @Html.PasswordFor(model => model.ConfirmPassword, new { style = "width:100%; padding:8px;" })
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 14px;">
            @Html.LabelFor(model => model.DepartmentId)

            @Html.DropDownListFor(
                model => model.DepartmentId,
                new SelectList(
                    (IEnumerable<MyLoginRegistration.Models.Department>)ViewBag.Departments,
                    "UserID",
                    "DepartmentName"
                ),
                "Select Department",
                new { @class = "form-control" }
            )
        </div>



        <div class="form-group">
            <div style="margin-top: 18px;">
                <input type="submit" value="Create" class="btn btn-primary" style="width:100%; padding:10px; font-weight:600;" />
            </div>
        </div>
    </div>
}



