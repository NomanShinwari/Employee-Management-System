@model MyLoginRegistration.Models.UserAccount

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Login";
}

<h2>Login</h2>
<style>
    body {
        background: #f5f7fa;
    }
</style>


@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "LoginForm" }))
{
    @Html.AntiForgeryToken()

    <div style="max-width: 400px; margin: 80px auto; padding: 25px; border: 1px solid #ddd; border-radius: 10px; background: #fff; box-shadow: 0px 4px 12px rgba(0,0,0,0.1);">
        <h4>UserAccount</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.Username, new { style = "display:block; margin-bottom:5px; font-weight:600;" })
            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { style = "width:100%; padding:8px;", } })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
        </div>

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.Password, new { style = "display:block; margin-bottom:5px; font-weight:600;" })
            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { style = "width:100%; padding:8px;" } })
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <div style="text-align:center; margin-top:15px;">
                <a href="@Url.Action("GoogleLogin", "Account")"
                   class="btn btn-danger"
                   style="width:100%; padding:10px;">
                    Continue with Google
                </a>
            </div>
            <div style="margin-top:15px; color: Blue; ">
                <input type="submit" value="Login" class="btn btn-primary" style="width:100%; padding:10px; font-weight:600;" />
            </div>
            <br />
            <div style="margin-top:15px;">
                <a href="@Url.Action("Register", "Account")" class="btn btn-link" style="display:block; text-align:center; margin-top:10px;">Sign Up</a>
            </div>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="color:green; margin-bottom:10px; font-weight:500;">
        @TempData["SuccessMessage"]
    </div>
}
<script src=@Url.Content("~/Scripts/Jquery/Login.js")></script>
